# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose up -d starts both) ---
DATABASE_URL="postgresql://pythagoras:pythagoras@localhost:5434/pythagoras?schema=public"
DATABASE_URL_TEST="postgresql://pythagoras:pythagoras@localhost:5433/pythagoras_test?schema=public"

# --- Auth.js ---
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Optional Google OAuth (button is hidden when GOOGLE_CLIENT_ID is empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" only when running behind a trusted reverse proxy (reads x-forwarded-for)
TRUST_PROXY="false"

# --- Payments ---
# mock = local demo only (throws when NODE_ENV=production). razorpay = real/test keys.
PAYMENT_PROVIDER="mock"
# Local-only: lets `pnpm demo` (production build, fast) use the mock provider. NEVER set on a public host.
ALLOW_MOCK_IN_PRODUCTION="true"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Business cap on a single order, in paise (default 100000000 = Rs 10,00,000).
# The authoritative value is the SiteSetting "max_order_paise"; this is a fallback.
MAX_ORDER_PAISE="100000000"

# --- Cron / ops ---
# Bearer secret for GET /api/cart/cleanup and GET /api/orders/cleanup
CRON_SECRET="change-me"
# Header secret for GET /api/dev/revalidate (404 in production)
DEV_REVALIDATE_SECRET="change-me"

# --- Images / video ---
# Comma-separated hostnames allowed by next/image remotePatterns
IMAGE_DOMAINS=""
# Comma-separated extra origins allowed to be framed for video (CSP report-only)
VIDEO_ORIGINS="https://www.youtube.com,https://player.vimeo.com"

# --- Seed ---
# true = create demo student/admin + demo students. NEVER set in production.
SEED_DEMO_ACCOUNTS="true"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
